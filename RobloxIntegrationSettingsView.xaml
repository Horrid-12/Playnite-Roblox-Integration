<UserControl x:Class="RobloxIntegration.RobloxIntegrationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="600">
    <StackPanel Margin="20">
        <TextBlock Text="Roblox Integration" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" />

        <!-- Mode Selection CheckBox -->
        <CheckBox x:Name="PublicModeCheck" 
                  Content="Use Public Favorites (No login / cookie required)" 
                  IsChecked="{Binding Settings.UsePublicFavorites}" 
                  FontWeight="SemiBold" FontSize="14" Margin="0,0,0,15" />

        <!-- Unauthenticated Public Section -->
        <StackPanel Visibility="{Binding IsChecked, ElementName=PublicModeCheck, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Roblox Username" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,5" />
            <TextBlock Text="Enter your Roblox username. Note: Your inventory/favorites must be set to 'Everyone' or 'Public' in Roblox privacy settings."
                       TextWrapping="Wrap" Margin="0,0,0,8" Foreground="Gray" FontSize="11" />
            <TextBox Text="{Binding Settings.RobloxUsername, UpdateSourceTrigger=PropertyChanged}"
                     Height="28" FontSize="12" VerticalContentAlignment="Center" Padding="5,0" />
        </StackPanel>

        <!-- Authenticated Cookie Section -->
        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=PublicModeCheck}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            
            <!-- Option 1: IWebView Login -->
            <TextBlock Text="Option 1: Browser Login" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,5" />
            <TextBlock Text="Opens an embedded browser for you to log into Roblox. The cookie will be captured automatically."
                       TextWrapping="Wrap" Margin="0,0,0,8" Foreground="Gray" FontSize="11" />
            <Button Content="Log in with Roblox"
                    Command="{Binding LoginCommand}"
                    Padding="12,6" HorizontalAlignment="Left" />

            <!-- Separator -->
            <Separator Margin="0,15,0,15" />

            <!-- Option 2: Manual Cookie -->
            <TextBlock Text="Option 2: Manual Cookie Entry" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,5" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="Gray" FontSize="11">
                <Run Text="If the browser doesn't load, paste your .ROBLOSECURITY cookie here." />
                <LineBreak />
                <Run Text="(Browser → F12 → Application → Cookies → .ROBLOSECURITY)" />
            </TextBlock>
            <TextBox Text="{Binding Settings.RobloSecurityCookie, UpdateSourceTrigger=PropertyChanged}"
                     Height="28" FontFamily="Consolas" FontSize="11" VerticalContentAlignment="Center" Padding="5,0" />
            
            <!-- Login Status -->
            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                <TextBlock Text="Cookie Status: " FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Not Logged In" />
                            <Setter Property="Foreground" Value="OrangeRed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUserLoggedIn}" Value="True">
                                    <Setter Property="Text" Value="Cookie Set" />
                                    <Setter Property="Foreground" Value="LimeGreen" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- Separator -->
        <Separator Margin="0,15,0,15" />

        <!-- Test Connection -->
        <StackPanel Orientation="Horizontal">
            <Button Content="Test Connection"
                    Command="{Binding TestConnectionCommand}"
                    Padding="12,6" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding ConnectionStatus}"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       FontSize="12" TextWrapping="Wrap" MaxWidth="450" />
        </StackPanel>

        <!-- Warning -->
        <TextBlock Text="⚠ Storing cookies can be risky if shared. If using Public Favorites, no sensitive data is stored."
                   TextWrapping="Wrap" Margin="0,18,0,0" Foreground="Gray" FontStyle="Italic" FontSize="11" />
    </StackPanel>
</UserControl>
