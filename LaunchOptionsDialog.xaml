<Window x:Class="RobloxIntegration.LaunchOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roblox Launch Options"
        Height="400" Width="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FFFFFFFF">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText"
                   FontSize="14" FontWeight="SemiBold"
                   TextWrapping="Wrap" Margin="0,0,0,4" />
        <TextBlock x:Name="DetailText"
                   FontSize="11" Foreground="Gray"
                   TextWrapping="Wrap" Margin="0,0,0,12" />

        <!-- ═══ Text input (private server / server instance) ═══ -->
        <StackPanel x:Name="TextInputPanel" Visibility="Collapsed">
            <TextBlock x:Name="CodeTypeLabel"
                       Text="Code type"
                       FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"
                       Visibility="Collapsed" />
            <ComboBox x:Name="CodeTypeBox"
                      Height="26" FontSize="12" Margin="0,0,0,6"
                      Visibility="Collapsed">
                <ComboBoxItem Content="Invite link / link code" />
                <ComboBoxItem Content="Private server access code" />
            </ComboBox>
            <TextBox x:Name="InputBox"
                     Height="28" FontSize="12" Padding="4,3"
                     VerticalContentAlignment="Center" />
        </StackPanel>

        <!-- ═══ Friend picker (join friend's activity) ═══ -->
        <StackPanel x:Name="FriendPanel" Visibility="Collapsed">
            <TextBlock Text="Search friends (username or display name):"
                       FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" />
            <TextBox x:Name="FriendSearchBox"
                     Height="26" FontSize="12" Padding="4,2" Margin="0,0,0,6"
                     VerticalContentAlignment="Center"
                     TextChanged="FriendSearchBox_TextChanged"
                     PreviewKeyDown="FriendSearchBox_PreviewKeyDown" />

            <DockPanel Margin="0,0,0,6">
                <Button x:Name="RefreshButton"
                        Content="&#x21bb; Refresh"
                        DockPanel.Dock="Right" Padding="8,3" Margin="8,0,0,0"
                        VerticalAlignment="Center" />
                <ComboBox x:Name="FriendBox"
                          Height="28" FontSize="12"
                          VerticalContentAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="FriendHint"
                       FontSize="11" Foreground="Gray"
                       TextWrapping="Wrap" Margin="0,0,0,10" />
            <TextBlock Text="Or join by username or user ID:"
                       FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" />
            <TextBox x:Name="ManualIdBox"
                     Height="26" FontSize="12" Padding="4,2"
                     VerticalContentAlignment="Center" />
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   FontSize="11" Foreground="OrangeRed"
                   TextWrapping="Wrap" Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel" Width="90" Margin="0,0,8,0"
                    IsCancel="True" />
            <Button x:Name="PlayButton"
                    Content="Play" Width="90"
                    IsDefault="True" Click="PlayButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
